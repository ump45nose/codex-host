          });
          try {
            const opened = await adapter.open({ kind: "create", cwd });
            expect(opened.ok).toBe(true);
            if (!opened.ok) return;
            const session = opened.value;
            const iterator = session.outputs[Symbol.asyncIterator]();
            await session.execute({
              type: "turn.start",
